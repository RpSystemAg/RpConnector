# PHPStan configuration for the production plugin surface.
#
# The first whole-repository pass produced hundreds of false positives because
# PHPStan had no WordPress model and was reading deliberately incomplete test
# shims. That setup problem is now removed with a reproducible dev-only toolchain
# pinned by composer.json/composer.lock:
#   - phpstan/phpstan 2.2.7
#   - php-stubs/wordpress-stubs 7.0.1
#   - szepeviktor/phpstan-wordpress 2.0.3
#
# There is deliberately no PHPStan baseline. Findings that remain after loading
# the official WordPress stubs and extension are defects or modelling gaps that
# must be resolved rather than frozen into an ignore file.

includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  # Level 5 is the production floor for this repository. It is high enough to
  # catch meaningful type/argument/control-flow defects without pretending this
  # dynamic WordPress codebase already has max-level annotations everywhere.
  # Raising the level is a future ratchet; lowering it to clear CI is forbidden.
  level: 5

  paths:
    - prstudio-unified-control

  # Test suites contain deliberately partial WordPress stand-ins and therefore
  # cannot be authoritative signatures for production static analysis.
  excludePaths:
    - tests
    - vendor
    - '*/node_modules/*'

  # WordPress defines environment constants before plugin boot. Functions,
  # classes and dynamic WordPress return types are supplied by the versioned
  # upstream stubs/extension above.
  bootstrapFiles:
    - tests/phpstan-bootstrap.php

  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: true
