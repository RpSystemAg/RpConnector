{
  "manifest_version": 3,
  "name": "PR STUDIO Unified Browser Agent",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Browser Agent e Local Studio per PR STUDIO.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "debugger",
    "activeTab",
    "downloads",
    "notifications",
    "webNavigation",
    "sidePanel",
    "tabGroups"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "PR STUDIO Browser"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-runtime-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/reconnect-backoff.js",
        "lib/runtime-dirty-notifier.js",
        "page-runtime.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ]
}
