{
  "schema_version": "1.0.0",
  "overlay_id": "prstudio-agency-browser-v10",
  "actions": [
    {
      "action": "playwright_flow",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_playwright_flow",
      "description": "Execute a bounded ordered browser flow as one Browser Agent task so deterministic multi-step UI work does not round-trip through the model between steps.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": true
      },
      "open_world": true,
      "read_only": false,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_playwright_flow"
    },
    {
      "action": "playwright_observation_bundle",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_playwright_observation_bundle",
      "description": "Secure redacted page, accessibility, network and console observation bundle.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "open_world": true,
      "read_only": true,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_playwright_observation_bundle"
    },
    {
      "action": "playwright_social_snapshot",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_playwright_social_snapshot",
      "description": "Best-effort visible social metric snapshot with explicit browser provenance.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "open_world": true,
      "read_only": true,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_playwright_social_snapshot"
    },
    {
      "action": "playwright_pointer_sequence",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_playwright_pointer_sequence",
      "description": "Locally approved bounded native CDP pointer, drag, wheel and touch sequence.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": false,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "open_world": true,
      "read_only": false,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_playwright_pointer_sequence"
    },
    {
      "action": "playwright_keyboard_sequence",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_playwright_keyboard_sequence",
      "description": "Locally approved bounded native CDP keyboard sequence.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": false,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "open_world": true,
      "read_only": false,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_playwright_keyboard_sequence"
    },
    {
      "action": "playwright_adopt_tabs",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_playwright_adopt_tabs",
      "description": "Explicitly adopt one or more already-open user HTTP(S) tabs into a ChatGPT execution lane without implicit active-tab fallback.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "open_world": false,
      "read_only": false,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_playwright_adopt_tabs"
    },
    {
      "action": "local_studio_run",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_local_studio_run",
      "description": "Run an allowlisted Local Studio workflow, monitor, baseline, diagnostic or recorder operation through an explicitly isolated remote lane.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "open_world": false,
      "read_only": false,
      "route": "/frontend-manage",
      "strategy": "normalized_browser_command",
      "tool_name": "rpconnector_frontend_manage_local_studio_run"
    },
    {
      "action": "mcp_bridge_call",
      "adapter_hook": "rpconnector_admin_execute_frontend_manage_mcp_bridge_call",
      "description": "Forward one vendor browser MCP list/call operation to the paired Browser Agent, which relays it to the local official MCP bridge.",
      "destructive": false,
      "domain": "browser",
      "executor": "browser_agent",
      "idempotent": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "chrome_devtools",
              "chrome_webmcp",
              "puppeteer",
              "selenium"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "tools/list",
              "tools/call"
            ]
          },
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          },
          "requested_tool": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "operation"
        ],
        "additionalProperties": false
      },
      "open_world": true,
      "read_only": false,
      "route": "/frontend-manage",
      "strategy": "vendor_mcp_bridge",
      "tool_name": "rpconnector_frontend_manage_mcp_bridge_call"
    }
  ]
}
