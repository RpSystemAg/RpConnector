{
  "schema_version": "1.0.0",
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "batch": 2,
  "note": "File-disjoint batch. Does not include ChatGPT reserved IDs or Business_Intelligence/Commerce_Engine/Agency_Capabilities/Browser_Orchestrator contracts.",
  "contracts": {
    "authority.outreach.engine": {
      "description": "Maintain a bounded SEO outreach CRM for producers, wineries, restaurants, bars, associations, events and editorial partners. Use list to read stored records, or upsert to create/update one record keyed by domain+entity. Returns the stored record(s). Does not send email or mutate the public site.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "upsert"
            ],
            "default": "list",
            "description": "list returns every stored outreach record. upsert requires domain."
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Required for upsert."
          },
          "entity": {
            "type": "string",
            "maxLength": 300
          },
          "contact": {
            "type": "string",
            "maxLength": 300
          },
          "relationship": {
            "type": "string",
            "maxLength": 200
          },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "authority": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "link_status": {
            "type": "string",
            "maxLength": 100,
            "description": "Sanitized status key. Runtime default is prospect."
          },
          "last_contact_gmt": {
            "type": "string",
            "maxLength": 80
          },
          "next_action": {
            "type": "string",
            "maxLength": 1000
          },
          "lane_token": {
            "type": "string",
            "maxLength": 256,
            "description": "Required only when an authenticated MCP client id is present."
          }
        }
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "records"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "records": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/outreach_record"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "record"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "record": {
                "$ref": "#/$defs/outreach_record"
              }
            }
          }
        ],
        "$defs": {
          "outreach_record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "domain",
              "entity",
              "contact",
              "relationship",
              "relevance",
              "authority",
              "link_status",
              "last_contact_gmt",
              "next_action",
              "updated_gmt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string"
              },
              "entity": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              },
              "relationship": {
                "type": "string"
              },
              "relevance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "authority": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "link_status": {
                "type": "string"
              },
              "last_contact_gmt": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              },
              "updated_gmt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "content.brief.compile": {
      "description": "Compile a deterministic editorial brief from keyword plus optional campaign, dominant URL, SERP intent, entities, products, links, missing competitor topics, schema type and forbidden overlap. Requires keyword. Persists the brief and returns it with a content hash. Does not publish content.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyword"
        ],
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "intent": {
            "type": "string",
            "maxLength": 100
          },
          "campaign_id": {
            "type": "string",
            "maxLength": 120
          },
          "target_url": {
            "type": "string",
            "maxLength": 2000
          },
          "secondary_queries": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "search_intent": {
            "type": "string",
            "maxLength": 100
          },
          "required_entities": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required_sections": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "products_verified": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "internal_links_in": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "internal_links_out": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "competitor_topics_missing": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "original_information_required": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "schema_type": {
            "type": "string",
            "maxLength": 80
          },
          "image_requirements": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "forbidden_overlap": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "lane_token": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "brief"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "brief": {
            "$ref": "#/$defs/brief"
          }
        },
        "$defs": {
          "brief": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "brief_id",
              "primary_keyword",
              "secondary_queries",
              "intent",
              "intent_hash",
              "target_url",
              "campaign",
              "required_entities",
              "required_sections",
              "products_verified",
              "internal_links_in",
              "internal_links_out",
              "competitor_topics_missing",
              "original_information_required",
              "schema_type",
              "image_requirements",
              "forbidden_overlap",
              "compiled_gmt",
              "brief_hash"
            ],
            "properties": {
              "brief_id": {
                "type": "string",
                "minLength": 1
              },
              "primary_keyword": {
                "type": "string"
              },
              "secondary_queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "intent": {
                "type": "string"
              },
              "intent_hash": {
                "type": "string"
              },
              "target_url": {
                "type": "string"
              },
              "campaign": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true
              },
              "required_entities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "products_verified": {
                "type": "array"
              },
              "internal_links_in": {
                "type": "array"
              },
              "internal_links_out": {
                "type": "array"
              },
              "competitor_topics_missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "original_information_required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "schema_type": {
                "type": "string"
              },
              "image_requirements": {
                "type": "array"
              },
              "forbidden_overlap": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "compiled_gmt": {
                "type": "string",
                "minLength": 1
              },
              "brief_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "content.claim.ledger": {
      "description": "Persist, list, check or invalidate factual claim evidence with source, authority, confidence and expiry. Use list/check to read, upsert to store, invalidate to mark stale. Missing or stale evidence never authorizes or vetoes publishing.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "check",
              "upsert",
              "invalidate"
            ],
            "default": "list"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Required for check, upsert and invalidate."
          },
          "source_url": {
            "type": "string",
            "maxLength": 2000
          },
          "authority": {
            "type": "string",
            "maxLength": 200
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "stale",
              "rejected"
            ]
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 31536000
          },
          "entity": {
            "type": "string",
            "maxLength": 300
          },
          "lane_token": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "claims"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "claims": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/claim"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "found",
              "verified"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "found": {
                "const": false
              },
              "verified": {
                "const": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "found",
              "verified",
              "expired",
              "claim"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "found": {
                "const": true
              },
              "verified": {
                "type": "boolean"
              },
              "expired": {
                "type": "boolean"
              },
              "claim": {
                "$ref": "#/$defs/claim"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "invalidated"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "invalidated": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "claim"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "claim": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        ],
        "$defs": {
          "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claim",
              "source_url",
              "authority",
              "confidence",
              "status",
              "checked_gmt",
              "expires_gmt",
              "entity"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "authority": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "status": {
                "type": "string"
              },
              "checked_gmt": {
                "type": "string"
              },
              "expires_gmt": {
                "type": "string"
              },
              "entity": {
                "type": "string"
              },
              "updated_gmt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "content.publish.transaction": {
      "description": "Create and publish WordPress content server-side with idempotency, taxonomy/Rank Math/schema, DB readback and non-blocking public/sitemap evidence. Requires title and content. Replaying the same idempotency key returns the existing post. Never rolls back a persisted mutation when public evidence is incomplete.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "slug": {
            "type": "string",
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8388608
          },
          "excerpt": {
            "type": "string",
            "maxLength": 5000
          },
          "post_type": {
            "type": "string",
            "maxLength": 80,
            "default": "post"
          },
          "status": {
            "type": "string",
            "enum": [
              "publish",
              "draft",
              "pending",
              "private",
              "future"
            ],
            "default": "publish"
          },
          "publish_date": {
            "type": "string",
            "maxLength": 80
          },
          "author": {
            "type": "integer",
            "minimum": 1
          },
          "categories": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "taxonomies": {
            "type": "object",
            "additionalProperties": true
          },
          "featured_image": {
            "type": "integer",
            "minimum": 1
          },
          "seo_title": {
            "type": "string",
            "maxLength": 500
          },
          "seo_description": {
            "type": "string",
            "maxLength": 2000
          },
          "canonical": {
            "type": "string",
            "maxLength": 2000
          },
          "schema_json": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 300
          },
          "verify_contains": {
            "type": "string",
            "maxLength": 1000
          },
          "required_claims": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "primary_keyword": {
            "type": "string",
            "maxLength": 300
          },
          "campaign_id": {
            "type": "string",
            "maxLength": 120
          },
          "policy_id": {
            "type": "string",
            "maxLength": 120
          },
          "allow_external_canonical": {
            "type": "boolean"
          },
          "lane_token": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "transaction_version",
              "idempotent_reuse",
              "executed",
              "post_id",
              "url",
              "status",
              "verified",
              "degraded",
              "blocking",
              "public_verification"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "transaction_version": {
                "type": "string",
                "minLength": 1
              },
              "idempotent_reuse": {
                "const": true
              },
              "executed": {
                "const": true
              },
              "post_id": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "degraded": {
                "type": "boolean"
              },
              "blocking": {
                "const": false
              },
              "public_verification": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok",
              "transaction_version",
              "state",
              "executed",
              "verified",
              "degraded",
              "blocking",
              "post_id",
              "url",
              "receipt",
              "technical_errors",
              "warnings"
            ],
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "transaction_version": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "SUCCESS",
                  "PUBLIC_PERSISTED_UNVERIFIED",
                  "TECHNICAL_ERROR"
                ]
              },
              "executed": {
                "const": true
              },
              "verified": {
                "type": "boolean"
              },
              "degraded": {
                "type": "boolean"
              },
              "blocking": {
                "const": false
              },
              "post_id": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string"
              },
              "receipt": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "post_id",
                  "url",
                  "status",
                  "db_verified",
                  "idempotency_key"
                ],
                "properties": {
                  "post_id": {
                    "type": "integer"
                  },
                  "url": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "expected_content_hash": {
                    "type": "string"
                  },
                  "observed_content_hash": {
                    "type": "string"
                  },
                  "seo_hash": {
                    "type": "string"
                  },
                  "schema_hash": {
                    "type": "string"
                  },
                  "db_verified": {
                    "type": "boolean"
                  },
                  "render_verified": {
                    "type": "boolean"
                  },
                  "sitemap_verified": {
                    "type": "boolean"
                  },
                  "public_verification": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "sitemap_verification": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "idempotency_key": {
                    "type": "string"
                  },
                  "observed_gmt": {
                    "type": "string"
                  }
                }
              },
              "technical_errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        ]
      }
    },
    "content.transaction.patch": {
      "description": "Apply a deterministic textual patch to one existing WordPress post using replace_exact, insert_before, insert_after or append_once. Identify the post by numeric id or by a resolvable site URL. Requires an exact search anchor except for append_once. Returns hashes, change flag and optional public verification. Does not roll back a persisted write when public evidence is incomplete.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "replacement"
        ],
        "anyOf": [
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "permalink"
            ],
            "properties": {
              "permalink": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "post_url"
            ],
            "properties": {
              "post_url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "permalink": {
            "type": "string",
            "maxLength": 2000
          },
          "target": {
            "type": "string",
            "maxLength": 2000
          },
          "post_url": {
            "type": "string",
            "maxLength": 2000
          },
          "operation": {
            "type": "string",
            "enum": [
              "replace_exact",
              "insert_before",
              "insert_after",
              "append_once"
            ]
          },
          "search": {
            "type": "string",
            "description": "Exact anchor. Required for every operation except append_once."
          },
          "replacement": {
            "type": "string"
          },
          "expected_before_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "expected_modified_gmt": {
            "type": "string"
          },
          "expected_occurrences": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "idempotency_marker": {
            "type": "string"
          },
          "public_verify": {
            "type": "boolean"
          },
          "verify_contains": {
            "type": "string"
          },
          "lane_token": {
            "type": "string",
            "maxLength": 256
          },
          "intervention_key": {
            "type": "string",
            "maxLength": 200
          },
          "impact": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "output_schema": {
        "oneOf": [
