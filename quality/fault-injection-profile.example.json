      "exercise": ["REPLACE", "RUN-MCP-OR-REMOTE-WORK-EXPECT-BOUNDED-FAILURE", "ARGV"],
      "oracle": ["REPLACE", "VERIFY-DURABLE-STATE-AND-NO-FALSE-SUCCESS", "ARGV"],
      "recover": ["REPLACE", "RESTORE-NETWORK-PATH", "ARGV"],
      "post_recovery": ["REPLACE", "VERIFY-QUEUED-WORK-RECOVERS", "ARGV"]
    },
    "process_kill_between_effect_and_checkpoint": {
      "inject": ["REPLACE", "ARM-PROCESS-KILL-AT-EFFECT-CHECKPOINT-WINDOW", "ARGV"],
      "exercise": ["REPLACE", "RUN-MUTATION-UNTIL-INJECTED-KILL", "ARGV"],
      "oracle": ["REPLACE", "INDEPENDENTLY-READ-BACK-EFFECT-AND-JOB-STATE", "ARGV"],
      "recover": ["REPLACE", "RESTART-WORKER", "ARGV"],
