{
  "schema_version": 1,
  "rule": "External production receipts must be downloaded only from successful workflow runs whose head_sha exactly equals the release commit. Local receipt files never override a downloaded receipt with the same name.",
  "sources": [
    {
      "id": "wordpress_lifecycle",
      "workflow": "production-wordpress-lifecycle.yml",
      "artifact_name_prefix": "production-evidence-wordpress-lifecycle-",
      "required_files": [
        "upgrade-migration.json",
        "backup-restore.json",
        "wordpress-lifecycle-details.json"
      ],
      "gates": ["upgrade_migration", "backup_restore"]
    },
    {
      "id": "real_staging",
      "workflow": "production-real-staging.yml",
      "artifact_name_prefix": "production-evidence-real-staging-",
      "required_files": [
        "auth-security.json",
        "auth-security-scenario-events.ndjson",
        "auth-security-scenario-details.json",
        "browser-isolation.json",
        "browser-isolation-scenario-events.ndjson",
        "browser-isolation-scenario-details.json",
        "transaction-integrity.json",
        "transaction-integrity-scenario-events.ndjson",
        "transaction-integrity-scenario-details.json",
        "concurrency-recovery.json",
        "concurrency-recovery-scenario-events.ndjson",
        "concurrency-recovery-scenario-details.json",
        "load-backpressure.json",
        "load-backpressure-scenario-events.ndjson",
        "load-backpressure-scenario-details.json",
        "remote-live-integration.json",
        "remote-live-integration-scenario-events.ndjson",
        "remote-live-integration-scenario-details.json",
        "observability-operability.json",
        "observability-operability-scenario-events.ndjson",
        "observability-operability-scenario-details.json",
        "compatibility-degradation.json",
        "compatibility-degradation-scenario-events.ndjson",
        "compatibility-degradation-scenario-details.json",
        "fault-injection.json",
        "fault-injection-events.ndjson",
        "fault-injection-details.json"
      ],
      "gates": [
        "auth_security",
        "browser_isolation",
        "transaction_integrity",
        "concurrency_recovery",
        "fault_injection",
        "load_backpressure",
        "remote_live_integration",
        "observability_operability",
        "compatibility_degradation"
      ]
    }
  ]
}
