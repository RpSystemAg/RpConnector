          "requires": [
            "database"
          ],
          "forbids": [
            "inventato"
          ],
          "scope": "result"
        },
        "accuracy": {
          "question": "I valori riportati corrispondono allo stato reale.",
          "requires": [
            "letti dal database"
          ],
          "forbids": [
            "stimato"
          ],
          "scope": "result"
        },
        "no_side_effects": {
          "question": "Nessuna scrittura non richiesta.",
          "requires": [
