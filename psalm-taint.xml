<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config https://raw.githubusercontent.com/vimeo/psalm/6.16.1/config.xsd"
    errorLevel="8"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="true"
    rememberPropertyAssignmentsAfterCall="false"
>
    <projectFiles>
        <directory name="prstudio-unified-control"/>
        <ignoreFiles>
            <directory name="tests"/>
            <directory name="vendor"/>
            <directory name="node_modules"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php"/>
        <file name="tests/psalm-wordpress-security-stubs.php"/>
    </stubs>
    <taintAnalysis>
        <ignoreFiles>
            <directory name="tests"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </taintAnalysis>
</psalm>
