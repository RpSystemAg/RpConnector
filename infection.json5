{
  "$schema": "https://raw.githubusercontent.com/infection/infection/0.34.1/resources/schema.json",
  "timeout": 20,
  "source": {
    "directories": [
      "prstudio-unified-control/includes"
    ]
  },
  "logs": {
    "text": "infection.log",
    "summary": "infection-summary.log"
  },
  "mutators": {
    "@default": true
  },
  "testFramework": "phpunit",
  "phpUnit": {
    "configDir": "."
  }
}
