<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/phpunit-kernel/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="false"
         failOnRisky="true"
         failOnWarning="true"
         processIsolation="true">
  <testsuites>
    <testsuite name="RP Studio critical kernel">
      <directory suffix="Test.php">tests/phpunit-kernel</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <file>prstudio-unified-control/includes/class-prstudio-uc-store.php</file>
      <file>prstudio-unified-control/includes/class-prstudio-uc-agency-runtime.php</file>
      <file>prstudio-unified-control/includes/class-prstudio-uc-job-engine.php</file>
      <file>prstudio-unified-control/includes/class-prstudio-uc-verifier.php</file>
      <file>prstudio-unified-control/includes/class-prstudio-uc-mcp-auth-v5.php</file>
      <file>prstudio-unified-control/includes/class-prstudio-uc-idempotency.php</file>
      <file>prstudio-unified-control/includes/class-prstudio-uc-publish-transaction.php</file>
    </include>
  </source>
</phpunit>
